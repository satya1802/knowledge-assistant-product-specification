# Copy to backend/.env and fill in. backend/.env is gitignored and must
# never be committed; this file documents every variable config_svc reads,
# with a safe default or a placeholder.

# --- Gemini (gemini_client) ------------------------------------------------
# Leave GEMINI_API_KEY unset (and OFFLINE_FALLBACK_ENABLED=true) to run the
# offline fallback mode with no key, for local development and tests.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OFFLINE_FALLBACK_ENABLED=true

# --- Auth & Session (auth_svc) ----------------------------------------------
SELF_REGISTRATION_ENABLED=true
# Set both to bootstrap the first administrator without registering by hand.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_COOKIE_NAME=ka_session
SESSION_TTL_DAYS=30
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15

# --- Knowledge base (doc_svc / ingest_svc) ----------------------------------
MAX_UPLOAD_MB=25
RELEVANCE_THRESHOLD=0.75

# --- Object store ------------------------------------------------------------
# "local" (default, filesystem volume) or "s3".
STORAGE_BACKEND=local
STORAGE_PATH=./data/uploads
S3_BUCKET=

# --- api_gateway ----------------------------------------------------------
# Comma-separated list of origins the SPA is served from in this deployment.
ALLOWED_ORIGINS=

# --- db ----------------------------------------------------------------
# Defaults to a local SQLite file so a fresh clone runs with no server to
# stand up. Point at Postgres + pgvector for anything that persists:
# postgresql+psycopg://user:password@localhost:5432/knowledge_assistant
DATABASE_URL=sqlite:///./app.db
